# DevShelf Environment Configuration

# Application
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
WEB_ORIGIN=http://localhost:5173

# Database (Local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/devshelf

# Authentication Session Secret (Long secure random string)
SESSION_SECRET=devshelf_super_secret_session_key_min_32_characters_long_12345!

# Razorpay Payment Gateway (Test mode credentials)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret

# Object Storage Configuration (local | s3 | r2)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage/local

# Optional S3/R2 Cloud Storage (required only if STORAGE_PROVIDER=s3 or r2)
S3_REGION=auto
S3_BUCKET=devshelf-storage
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email Notifications (console | smtp)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@devshelf.io
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Logging
LOG_LEVEL=debug
